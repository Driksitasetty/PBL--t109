rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Missing person photographs (Module 1)
    match /lost_persons/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Guide verification ID documents (Module 5)
    match /guides/{guideDocId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
