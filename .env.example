# ============================================================
# Environment Configuration Template — Darshan Setu
# ============================================================
# Copy this file to .env and configure your local or cloud values.
# NEVER commit your actual service account credentials or private keys.

# Flask Backend Server Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True

# Firebase Cloud Integration (Optional: Local persistence works out of the box)
# Path to your Firebase service account private key JSON file (e.g., backend/firebase_key.json)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Frontend Configuration (React / Vite)
VITE_FLASK_API_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
